# OCSF Pipeline Environment Configuration

# Security
SECRET_KEY=change-this-to-a-random-secret-in-production

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BATCH_SIZE=500
KAFKA_BATCH_TIMEOUT_MS=100

# Redis
REDIS_URL=redis://redis:6379

# Database (SQLite by default, switch to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:////data/ocsf.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ocsf

# OCSF Schema auto-update interval (hours)
OCSF_SCHEMA_UPDATE_INTERVAL_HOURS=24

# Performance
MAX_WORKERS=4
PIPELINE_BATCH_SIZE=1000

# CORS (comma-separated for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
