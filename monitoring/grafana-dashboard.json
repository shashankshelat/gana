{
  "title": "GANA",
  "uid": "ocsf-pipeline",
  "schemaVersion": 38,
  "tags": ["ocsf", "security", "pipeline"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "id": 1, "title": "Events/sec", "type": "stat", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "rate(ocsf_events_received_total[1m])", "legendFormat": "Events/sec" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "title": "Total Events Mapped", "type": "stat", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(ocsf_events_mapped_total)", "legendFormat": "Mapped" }]
    },
    {
      "id": 3, "title": "Failed Events", "type": "stat", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(ocsf_events_failed_total)", "legendFormat": "Failed" }],
      "options": { "colorMode": "background", "thresholds": { "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}] } }
    },
    {
      "id": 4, "title": "DLQ Size", "type": "stat", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "ocsf_dlq_size", "legendFormat": "DLQ" }],
      "options": { "colorMode": "background", "thresholds": { "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 100}] } }
    },
    {
      "id": 5, "title": "Anomalies Detected", "type": "stat", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(ocsf_anomalies_detected_total)", "legendFormat": "Anomalies" }]
    },
    {
      "id": 6, "title": "Throughput by Connector", "type": "timeseries", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(ocsf_events_received_total[1m])", "legendFormat": "{{connector_type}}" }]
    },
    {
      "id": 7, "title": "Events Forwarded by Destination", "type": "timeseries", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(ocsf_events_forwarded_total[1m])", "legendFormat": "{{forwarder_type}}" }]
    },
    {
      "id": 8, "title": "Mapping Latency (p95)", "type": "timeseries", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(ocsf_mapping_duration_seconds_bucket[5m]))", "legendFormat": "p95 {{connector_type}}" }]
    },
    {
      "id": 9, "title": "PII Fields Masked", "type": "timeseries", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "targets": [{ "expr": "rate(ocsf_pii_fields_masked_total[5m])", "legendFormat": "{{pattern_type}}" }]
    }
  ]
}
